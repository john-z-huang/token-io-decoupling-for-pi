{
  "name": "token-io-decoupling-for-pi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pi Coding Agent 的 Coding YAML 路线与条件 Hooks",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "skills": [
      "./docs/skill"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "scripts": {
    "build:skill": "uv run --locked --script scripts/compile-reference-dsl.py",
    "prepare": "npm run build:skill",
    "lint": "eslint --max-warnings 0 eslint.config.js",
    "lint:fix": "npm run lint -- --fix --fix-type layout"
  },
  "files": [
    "CHANGELOG/CHANGELOG.md",
    "CHANGELOG/CODE_QUALITY.md",
    "docs/rules",
    "docs/project",
    "docs/skill",
    "agents/*.md",
    "integrations/pi-subagent/*",
    "README.md"
  ],
  "dependencies": {
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}

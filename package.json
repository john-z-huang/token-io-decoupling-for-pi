{
  "name": "token-io-decoupling-for-pi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pi Coding Agent 的 Coding 工作流引擎与条件规则 Hooks",
  "keywords": ["pi-package"],
  "engines": { "node": ">=24" },
  "pi": {
    "extensions": ["./extensions/coding-workflow/index.ts"],
    "skills": ["./docs/skill"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "scripts": {
    "test": "node --test extension-tests/*.test.mjs",
    "check:hooks": "node scripts/check-pi-hooks.mjs",
    "check:types": "node scripts/check-pi-extension-types.mjs",
    "check:load": "node scripts/check-pi-extension-load.mjs",
    "check:subagents": "node scripts/check-pi-subagents.mjs"
  },
  "files": ["extensions/coding-workflow/*.ts", "docs/skill", "agents/*.md", "integrations/pi-subagent/*", "README.md"]
}
